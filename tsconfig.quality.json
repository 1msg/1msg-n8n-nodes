{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noEmitOnError": true,
		"rootDir": ".",
		"jsx": "preserve"
	},
	"include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
	"exclude": ["**/node_modules/**", "**/dist/**", "tools/quality/**", "quality/reports/**"]
}
