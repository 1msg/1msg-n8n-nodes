{
	"name": "n8n-nodes-1msg",
	"version": "0.1.0",
	"description": "n8n community node for the 1MSG WhatsApp Business API",
	"license": "MIT",
	"homepage": "https://1msg.io",
	"keywords": ["n8n-community-node-package"],
	"author": {
		"name": "1MSG",
		"email": "support@1msg.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/1msg/1msg-n8n-nodes.git"
	},
	"scripts": {
		"build": "n8n-node build && node scripts/copy-codex.js",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "npm run build && node --test test/*.test.js"
	},
	"files": ["dist"],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": ["dist/credentials/OneMsgApi.credentials.js"],
		"nodes": [
			"dist/nodes/Waba/Waba.node.js",
			"dist/nodes/WabaTrigger/WabaTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
