{
	"name": "@1msg/n8n-nodes-1msg",
	"version": "0.1.7",
	"description": "Send WhatsApp messages, receive webhooks, and make any API request using the official WhatsApp API through 1MSG.",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://1msg.io",
	"keywords": [
		"n8n-community-node-package",
		"waba",
		"whatsapp",
		"whatsapp-business-api",
		"1msg"
	],
	"author": {
		"name": "1MSG",
		"email": "1msg.company@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/1msg/1msg-n8n-nodes.git"
	},
	"scripts": {
		"build": "n8n-node build && node scripts/copy-codex.js",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "npm run build && node --test test/*.test.js",
		"typecheck": "tsc -p tsconfig.quality.json",
		"lint:static": "node tools/quality/node_modules/eslint/bin/eslint.js -c eslint.static.config.mjs . --max-warnings=0",
		"lint:typed": "node tools/quality/node_modules/eslint/bin/eslint.js -c eslint.typed.config.mjs . --max-warnings=0",
		"lint:unused:production": "node tools/quality/run.mjs unused-production",
		"lint:unused:full": "node tools/quality/run.mjs unused-full",
		"lint:duplicates": "node tools/quality/run.mjs duplicates",
		"quality:guards": "node tools/quality/run.mjs guards",
		"lint:arch": "node tools/quality/node_modules/dependency-cruiser/bin/dependency-cruiser.mjs --config .dependency-cruiser.cjs nodes utils credentials",
		"test:quality": "node scripts/quality-negative.mjs nodes && node --test --test-concurrency=1 scripts/quality-hook.test.mjs scripts/quality-extensions.test.mjs",
		"lint:complexity": "node tools/quality/run.mjs report --kind eslint --name complexity -- node tools/quality/node_modules/eslint/bin/eslint.js -c eslint.complexity.config.mjs . --format json",
		"lint:duplicates:full": "node tools/quality/run.mjs duplicates-full",
		"lint:framework": "n8n-node lint",
		"format:check": "node tools/quality/node_modules/prettier/bin/prettier.cjs --check .",
		"format": "node tools/quality/node_modules/prettier/bin/prettier.cjs --write .",
		"test:pack": "node scripts/pack-smoke.mjs",
		"test:preset": "node --test tools/quality/test/*.test.mjs",
		"hooks:install": "node tools/quality/node_modules/husky/bin.js"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/OneMsgApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Waba/Waba.node.js",
			"dist/nodes/WabaTrigger/WabaTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "npm@11.17.0",
	"lint-staged": {
		"*.{js,jsx,mjs,cjs}": [
			"node tools/quality/node_modules/prettier/bin/prettier.cjs --write",
			"node tools/quality/node_modules/eslint/bin/eslint.js --config eslint.static.config.mjs --max-warnings=0"
		],
		"*.{ts,tsx,mts,cts}": [
			"node tools/quality/node_modules/prettier/bin/prettier.cjs --write",
			"node tools/quality/node_modules/eslint/bin/eslint.js --config eslint.static.config.mjs --max-warnings=0",
			"node tools/quality/node_modules/eslint/bin/eslint.js --config eslint.typed.config.mjs --max-warnings=0"
		],
		"*.{json,md,yml,yaml}": "node tools/quality/node_modules/prettier/bin/prettier.cjs --write"
	}
}
